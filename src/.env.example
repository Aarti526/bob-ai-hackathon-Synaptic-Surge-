# Copy to .env and fill in. If ANTHROPIC_API_KEY is left blank, ThreatLens
# falls back to a deterministic mock LLM provider so the demo still runs.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# Correlation
CORRELATION_TIME_WINDOW_MINUTES=15
CORRELATION_MIN_SCORE=0.45

# RAG
RAG_TOP_K=3
RAG_SIMILARITY_THRESHOLD=0.15

# LLM
LLM_TIMEOUT_SECONDS=20
LLM_TEMPERATURE=0.2
